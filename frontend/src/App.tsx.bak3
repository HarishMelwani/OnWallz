import { useEffect, useState } from "react";
import type { Snapshot } from "./lib/types";
import * as db from "./lib/store";
import type { WalletState } from "./lib/wallet";
import { hasContract } from "./lib/config";
import { Topbar } from "./components/Topbar";
import { Home } from "./components/Home";
import { Wall } from "./components/Wall";
import { CreatePage } from "./components/CreatePage";
import { Probe } from "./components/Probe";
import { Deploy } from "./components/Deploy";

type Route =
  | { name: "home" }
  | { name: "wall"; handle: string }
  | { name: "new" }
  | { name: "deploy" }
  | { name: "probe" };

function parse(hash: string): Route {
  const h = hash.replace(/^#\/?/, "");
  if (h.startsWith("w/")) return { name: "wall", handle: decodeURIComponent(h.slice(2)) };
  if (h === "new") return { name: "new" };
  if (h === "deploy") return { name: "deploy" };
  if (h === "probe") return { name: "probe" };
  return { name: "home" };
}

export default function App() {
  const [snap, setSnap] = useState<Snapshot>(() => db.load());
  const [route, setRoute] = useState<Route>(() => parse(window.location.hash));
  const [toast, setToast] = useState<string | null>(null);
  // Remembered across reloads so a refresh never looks like "no wall yet".
  // Cleared only by an explicit disconnect.
  const [lastAddress, setLastAddress] = useState<string | null>(() =>
    localStorage.getItem("onwallz.last"),
  );
  const [wallet, setWallet] = useState<WalletState>({
    status: "idle",
    address: null,
    error: null,
  });

  useEffect(() => {
    const onHash = () => setRoute(parse(window.location.hash));
    window.addEventListener("hashchange", onHash);
    return () => window.removeEventListener("hashchange", onHash);
  }, []);

  useEffect(() => {
    if (!toast) return;
    const t = setTimeout(() => setToast(null), 3200);
    return () => clearTimeout(t);
  }, [toast]);

  function go(hash: string) {
    window.location.hash = hash;
  }

  function commit(next: Snapshot) {
    setSnap(next);
    db.save(next);
  }

  const patchWallet = (s: Partial<WalletState>) => setWallet((w) => ({ ...w, ...s }));

  // The identity is whatever wallet is connected right now. Disconnecting drops
  // it instantly: no page, no ownership, no "yours" badge.
  const live = wallet.status === "connected" && !!wallet.address;
  const knownAddress = live ? wallet.address : lastAddress;
  const session = db.sessionFor(snap, knownAddress);

  // One wall per wallet: once yours exists, #/new is not a place you can be.
  const view =
    route.name === "new" && session.me
      ? ({ name: "wall", handle: session.me.handle } as const)
      : route;

  useEffect(() => {
    if (knownAddress) {
      console.info(
        "[onwallz] session:",
        { address: knownAddress, owns: session.me?.handle ?? null },
        "pages:",
        Object.values(snap.pages).map((p) => `${p.handle}→${p.owner.slice(0, 10)}`),
      );
    }
  }, [knownAddress, session.me?.handle, snap.pages]);

  useEffect(() => {
    if (route.name === "new" && session.me) {
      window.history.replaceState(null, "", `#/w/${session.me.handle}`);
    }
  }, [route.name, session.me?.handle]);

  async function connect() {
    const walletLib = await import("./lib/wallet");
    const result = await walletLib.connect(patchWallet);
    if ("error" in result) {
      setToast(result.error);
      return;
    }

    // A wallet may share several accounts. Prefer the one that already owns a
    // wall, so reconnecting never looks like "this wallet has no wall".
    const accounts = result.accounts;
    const owning = accounts.find((a) => db.pageForOwner(snap, a.address));
    const address = (owning ?? accounts[0]).address;

    if (address !== wallet.address) patchWallet({ address });
    setLastAddress(address);
    localStorage.setItem("onwallz.last", address);

    // Nothing local is required to own a wall: ask the contract.
    if (hasContract()) {
      try {
        const chain = await import("./lib/chain");
        const known = db.pageForOwner(snap, address);
        if (!known) {
          const handle = await chain.pageOf(address, address);
          if (handle) {
            const page = await chain.readPage(handle, address);
            commit(db.adoptPage(snap, handle, page.display, address));
            setToast(`restored @${handle} from the contract`);
          }
        }
      } catch (err) {
        setToast(
          `could not restore your page from the contract: ${
            err instanceof Error ? err.message : String(err)
          }`,
        );
      }
    }
    setToast(
      accounts.length > 1
        ? `connected as ${address.slice(0, 6)}…${address.slice(-4)} (${accounts.length} accounts)`
        : "wallet connected",
    );
  }

  async function disconnect() {
    const walletLib = await import("./lib/wallet");
    await walletLib.disconnect(patchWallet);
    localStorage.removeItem("onwallz.last");
    setLastAddress(null);
    setToast("disconnected");
  }

  async function create(handle: string, display: string): Promise<string | null> {
    const h = handle.trim().toLowerCase();

    if (wallet.status !== "connected" || !wallet.address) {
      return "connect your wallet first — a page belongs to an address";
    }

    if (hasContract()) {
      try {
        const chain = await import("./lib/chain");
        await chain.createPage(h, display.trim(), wallet.address);
        setToast("handle registered on Aztec");
      } catch (err) {
        const message = err instanceof Error ? err.message : String(err);
        return message;
      }
    }

    const { snapshot, error } = db.createPage(snap, h, display, wallet.address);
    if (error) return error;
    commit(snapshot);
    go(`#/w/${h}`);
    return null;
  }

  async function write(
    wall: string,
    text: string,
    bonusId: string | undefined,
    identity: { mode: 0 | 1; tag?: string },
  ): Promise<string | null> {
    if (wallet.status !== "connected" || !wallet.address) {
      return "connect your wallet to write";
    }
    // Pre-flight the local rules, but the chain is authoritative.
    const pre = db.write(session, wall, text, bonusId, identity);
    if (pre.error) return pre.error;

    try {
      await chain.writeOnWall(wall, text, wallet.address, bonusId, identity);
    } catch (err) {
      return `the contract rejected this: ${err instanceof Error ? err.message : String(err)}`;
    }
    // Mirror only after the transaction was accepted.
    commit(pre.snapshot);
    setToast(identity.mode === 1 ? `written as @${identity.tag}` : "left on the wall — anonymously");
    return null;
  }

  function reply(wall: string, postId: string, text: string): string | null {
    if (wallet.status !== "connected" || !wallet.address) {
      return "connect your wallet to reply";
    }
    const { snapshot, error } = db.reply(session, wall, postId, text);
    if (error) return error;
    commit(snapshot);
    setToast("replied — they can write once more");
    return null;
  }

  return (
    <div className="shell">
      <Topbar
        me={session.me?.handle ?? null}
        wallet={wallet}
        onHome={() => go("#/")}
        onConnect={connect}
        onDisconnect={disconnect}
      />

      <main className={`main ${view.name === "home" ? "wide" : ""}`}>
        {view.name === "home" && (
          <Home
            snap={session}
            onLookup={(h) => go(`#/w/${h}`)}
            goCreate={() => go("#/new")}
            walletError={wallet.status === "error" ? wallet.error : null}
            onConnect={connect}
            walletConnected={wallet.status === "connected"}
            address={knownAddress}
          />
        )}

        {view.name === "probe" && <Probe />}

        {view.name === "deploy" && (
          <Deploy wallet={wallet} onConnect={connect} address={knownAddress} />
        )}

        {view.name === "new" && (
          <CreatePage
            onCreate={create}
            wallet={wallet}
            onChain={hasContract()}
            onConnect={connect}
          />
        )}

        {view.name === "wall" && (
          <Wall
            snap={session}
            handle={view.handle}
            onWrite={(t, b, id) => write(view.handle, t, b, id)}
            onReply={(id, t) => reply(view.handle, id, t)}
            onHome={() => go("#/")}
            goCreate={() => go("#/new")}
            walletConnected={wallet.status === "connected"}
            onConnect={connect}
          />
        )}
      </main>

      <footer className="foot">OnWallz · anonymous authorship on aztec · nulo wallet</footer>

      {toast && <div className="toast">{toast}</div>}
    </div>
  );
}