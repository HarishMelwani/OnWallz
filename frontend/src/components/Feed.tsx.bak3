import { useEffect, useState } from "react";
import { readActivity } from "../lib/chain";

type Item = Awaited<ReturnType<typeof readActivity>>[number];

type Props = {
  address: string | null;
  contractReady: boolean;
  goWall: (wall: string) => void;
};

export function Feed({ address, contractReady, goWall }: Props) {
  const [items, setItems] = useState<Item[] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [tab, setTab] = useState<"latest" | "trending">("latest");

  useEffect(() => {
    if (!contractReady || !address) return;
    let cancelled = false;
    setItems(null);
    setError(null);
    readActivity(40, address)
      .then((rows) => {
        if (!cancelled) setItems(rows);
      })
      .catch((err) => {
        if (!cancelled) setError(err instanceof Error ? err.message : String(err));
      });
    return () => {
      cancelled = true;
    };
  }, [contractReady, address]);

  const trending =
    items &&
    Object.entries(
      items.reduce<Record<string, { wall: string; posts: number; replies: number }>>((acc, it) => {
        const w = it.wall || "unknown";
        acc[w] ??= { wall: w, posts: 0, replies: 0 };
        acc[w].posts += 1;
        if (it.replied) acc[w].replies += 1;
        return acc;
      }, {}),
    )
      .map(([, v]) => v)
      .sort((a, b) => b.posts - a.posts)
      .slice(0, 10);

  if (!contractReady) {
    return (
      <div className="empty">
        <span className="glyph">◌</span>
        <h2>no contract configured</h2>
        <p className="muted">the feed reads from the chain, so OnWallz needs a deployed contract first.</p>
      </div>
    );
  }

  if (!address) {
    return (
      <div className="empty">
        <span className="glyph">◌</span>
        <h2>connect to read the feed</h2>
        <p className="muted">reads are public, but the node needs an account to simulate them.</p>
      </div>
    );
  }

  return (
    <div className="card" style={{ overflow: "hidden" }}>
      <div className="wall-head">
        <div className="who grow">
          <h2>the feed</h2>
          <span className="hint">who wrote what, on whose wall</span>
        </div>
        <div className="seg" role="group" aria-label="feed section">
          <button
            className={`btn sm ${tab === "latest" ? "primary" : "ghost"}`}
            onClick={() => setTab("latest")}
          >
            latest
          </button>
          <button
            className={`btn sm ${tab === "trending" ? "primary" : "ghost"}`}
            onClick={() => setTab("trending")}
          >
            trending
          </button>
        </div>
      </div>

      {error && (
        <div className="composer">
          <div className="notice">could not read the feed: {error}</div>
        </div>
      )}

      {items === null && !error && (
        <div className="posts">
          <div className="empty">
            <span className="glyph">·</span>
            reading the chain…
          </div>
        </div>
      )}

      {items?.length === 0 && (
        <div className="posts">
          <div className="empty">
            <span className="glyph">·</span>
            nothing on any wall yet.
            <br />
            <span className="hint">be the first to leave something.</span>
          </div>
        </div>
      )}

      <div className="posts">
        {tab === "latest" &&
          items?.map((it) => {
            const target = it.handle || it.wall.slice(0, 10);
            return (
              <article className="post" key={it.seq}>
                <div className="body">
                  <div className="meta">
                    <span className="muted">anonymous</span>
                    <span className="muted"> wrote on </span>
                    <button
                      className="linkish"
                      onClick={() => goWall(target)}
                      title={`open @${target}`}
                    >
                      @{target}
                    </button>
                    <span className="muted"> wall</span>
                  </div>
                  <div className="text">{it.text}</div>
                  {it.replied && (
                    <div className="reply">
                      <span className="who">@{target} replied</span>
                      <span className="text">{it.replyText}</span>
                    </div>
                  )}
                  <div className="row" style={{ marginTop: 10 }}>
                    <button className="btn ghost sm" onClick={() => goWall(target)}>
                      view
                    </button>
                  </div>
                </div>
              </article>
            );
          })}

        {tab === "trending" &&
          trending?.map((t) => (
            <article className="post" key={t.wall}>
              <div className="body">
                <div className="meta">
                  <span className="muted">@{t.wall}</span>
                </div>
                <div className="text">
                  {t.posts} {t.posts === 1 ? "note" : "notes"} · {t.replies}{" "}
                  {t.replies === 1 ? "reply" : "replies"}
                </div>
                <div className="row" style={{ marginTop: 10 }}>
                  <button className="btn ghost sm" onClick={() => goWall(t.wall)}>
                    view wall ↗
                  </button>
                </div>
              </div>
            </article>
          ))}
      </div>
    </div>
  );
}
